$TTL   60000
@               IN      SOA     ROOT-SERVER.    root.ROOT-SERVER. (
                        2006031201 ; serial
                        28800 ; refresh
                        14400 ; retry
                        3600000 ; expire
                        0 ; negative cache ttl
                        )

@               IN  NS  ROOT-SERVER.
ROOT-SERVER.	IN	A	192.168.0.5

# Se voglio cercare il dominio .it allora chiedo a dnsit che ha indirizzo ip 192.168.0.1
it.		        IN 	NS	dnsit.it.
dnsit.it.	    IN 	A	192.168.0.1

# Se voglio cercare il dominio .net allora chiedo a dnsnet che ha indirizzo ip 192.168.0.2
net.		    IN	NS	dnsnet.net.
dnsnet.net.	    IN	A	192.168.0.2
