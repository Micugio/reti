# Configurazione indirizzo ip del host per la porta eth0
ip a add 192.168.0.100/24 dev eth0
ip link set eth0 up

# Configurazione indirizzo ip del host per la porta eth1
ip a add 192.168.2.101/24 dev eth1
ip link set eth1 up

# Se voglio raggiungere la rete 192.168.1.0(=pc2) delego all'host 192.168.2.100(=r2)
ip route add 192.168.1.0/24 via 192.168.2.100
